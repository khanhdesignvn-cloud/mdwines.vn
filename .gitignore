# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma cli-installed agent skills (not project code)
/.claude/skills
/.windsurf
/.agents
/skills-lock.json

# sqlite database
/prisma/dev.db
/prisma/*.db
/prisma/*.db-journal

# user-uploaded product photos (served from disk at runtime, not committed)
/uploads/products/*
!/uploads/products/.gitkeep
