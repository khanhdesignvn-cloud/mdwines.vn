DATABASE_URL="file:./dev.db"

# Secret used to sign admin AND customer session tokens. Generate a strong random
# value in production, e.g. `openssl rand -base64 32`.
AUTH_SECRET="change-me"

# --- Email (order confirmation to customer + new-order notice to admin) ---
# Optional. If any of these are missing, email sending is skipped (logged as a
# warning) rather than failing the checkout. Works with Gmail (use an App
# Password, not your normal password) or any SMTP provider.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Where "new order" notification emails are sent. Leave blank to disable.
ADMIN_NOTIFY_EMAIL=""

# --- VNPay (online payment) ---
# Optional. Get sandbox credentials free at https://sandbox.vnpayment.vn.
# Without these set, customers simply won't be able to complete the VNPay
# option at checkout (a clear error is shown instead of a crash).
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
# Sandbox by default; switch to the production VNPay URL once you have a
# real merchant account.
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
