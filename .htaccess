RewriteEngine On
RewriteBase /
RewriteRule ^api/trpc/orders-lib\.php$ - [F,L]
RewriteCond %{REQUEST_URI} !^/api/trpc/index\.php$
RewriteRule ^api/trpc(/.*)?$ api/trpc/index.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^$ index.html [L]
RewriteRule ^checkout/?$ checkout.html [L]
RewriteRule ^(barossa|cau-chuyen|qua-tang|ruou-vang|khoanh-khac|the-cellar-journal|tu-van-chon-vang)(/.*)?$ index.html [L]
RewriteRule ^ - [R=404,L]
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|js|css|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
